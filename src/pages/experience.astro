---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceCard from '../components/features/ExperienceCard';
import AnalyticsTracker from '../components/analytics/AnalyticsTracker';
import { fetchExperiences } from '../lib/fetchExperiences';

// Fetch all experiences from Sanity, then split them into their two sections.
const experiences = await fetchExperiences();

const sections = [
  {
    id: 'work',
    heading: 'WORK EXPERIENCE',
    blurb: 'Co-ops, internships, and paid roles',
    entries: experiences.filter((e) => e.category !== 'campus'),
  },
  {
    id: 'campus',
    heading: 'CAMPUS & CLUBS',
    blurb: 'Student orgs, studios, and clubs at Northeastern',
    entries: experiences.filter((e) => e.category === 'campus'),
  },
].filter((section) => section.entries.length > 0);
---

<BaseLayout title="Gym Badges - Logan's Lokédex">
  <AnalyticsTracker pageName="Experience" client:load />
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Header -->
    <section class="text-center mb-12 pt-8">
      <h1 class="font-pokemon text-4xl md:text-5xl text-poke-yellow mb-4">
        GYM BADGES
      </h1>
      <p class="text-xl text-white/80 mb-8">
        My professional journey through different teams and organizations
      </p>
      
      <a
        href="/"
        class="inline-block bg-poke-red hover:bg-poke-red/80 transition-colors px-6 py-3 rounded-lg font-bold text-white"
      >
        ← Back to Home
      </a>
    </section>

    <!-- Experience Timeline -->
    {sections.map((section) => (
      <section class="pb-8 mb-8">
        <div class="flex items-center gap-4 mb-8">
          <div class="h-1 flex-1 bg-poke-yellow/30 rounded-full"></div>
          <div class="text-center">
            <h2 class="font-pokemon text-xl md:text-2xl text-poke-yellow">
              {section.heading}
            </h2>
            <p class="text-sm text-white/60 mt-2">{section.blurb}</p>
          </div>
          <div class="h-1 flex-1 bg-poke-yellow/30 rounded-full"></div>
        </div>

        <div class="flex flex-col gap-12">
          {section.entries.map((experience, index) => (
            <ExperienceCard
              title={experience.title}
              company={experience.company}
              companyLogo={experience.companyLogo}
              companyWebsite={experience.companyWebsite}
              location={experience.location}
              startDate={experience.startDate}
              endDate={experience.endDate}
              current={experience.current}
              description={experience.description}
              projects={experience.projects}
              index={index}
              client:load
            />
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>